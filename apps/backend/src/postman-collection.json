      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{AUTH_TOKEN}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currency\": \"USD\"\n}"
        },
        "url": {
          "raw": "http://localhost:4000/api/virtual-account/create",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "virtual-account", "create"]
        }
      }
    },
    {
