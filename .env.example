# Database Configuration (Supabase)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# Banking
BANKING_PROVIDER=currencycloud
UNIT_API_KEY=<your-unit-api-key>
CURRENCYCLOUD_LOGIN_ID=<your-currencycloud-email>
CURRENCYCLOUD_API_KEY=<your-currencycloud-api-key>

# Crypto custody
CRYPTO_CUSTODY_PROVIDER=tatum
TATUM_API_KEY=<your-tatum-api-key>
FIREBLOCKS_API_KEY=<your-fireblocks-api-key>
FIREBLOCKS_API_SECRET_PATH=<path-to-fireblocks-secret-key.pem>

# Blockchain nodes
EVM_PROVIDER=alchemy
ALCHEMY_API_KEY=<your-alchemy-api-key>
TRON_PROVIDER=trongrid
TRONGRID_API_KEY=<your-trongrid-api-key>

# KYC
KYC_PROVIDER=sumsub
SUMSUB_API_KEY=<your-sumsub-api-key>
SUMSUB_SECRET_KEY=<your-sumsub-secret-key>
SUMSUB_LEVEL_NAME=id-only

# Notifications
EMAIL_PROVIDER=resend
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM_EMAIL=onboarding@resend.dev
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_PHONE_NUMBER=<your-twilio-phone-number>

# Banking Circle Configuration
BANKING_CIRCLE_BASE_URL=https://sandbox.bankingcircleconnect.com
BANKING_CIRCLE_AUTH_URL=https://authorizationsandbox.bankingcircleconnect.com
BANKING_CIRCLE_USERNAME=
BANKING_CIRCLE_PASSWORD=
BANKING_CIRCLE_CERTIFICATE_PATH=
BANKING_CIRCLE_CERTIFICATE_PASSWORD=

